generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-tenant hierarchy: SUPER_ADMIN (developer) → Tenant (franchise) →
// Branch (per-city outlet) → ADMIN (1+ branches of one franchise) / STAFF.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  logo      String? // base64 data URL (PNG), downscaled to ≤256px
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches   Branch[]
  users      User[]
  categories Category[]
  services   Service[]
  customers  Customer[]
  announcements Announcement[]
}

model Branch {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  name        String
  city        String?
  address     String?
  phone       String?
  logo        String? // optional per-branch logo override (base64 data URL)
  upiId       String?
  upiQrImage  String? // base64 data URL of the branch's printed UPI QR
  ownerMobile String? // branch owner's WhatsApp (10 digits) for summary reports
  billPrefix  String  @default("SX") // bill numbers are per-branch: PREFIX-0001
  billCounter Int     @default(0)
  /** Branches opened by franchise admins need super-admin approval before they go live. */
  approved   Boolean   @default(false)
  approvedAt DateTime?
  // Branch-level billing settings (GST / loyalty / receipt)
  gstEnabled     Boolean @default(false)
  gstPct         Float   @default(18)
  /** The branch's own GSTIN (15-char GST identification number) — printed on
      tax invoices when GST is enabled. Optional: small salons bill without GST. */
  gstin          String?
  loyaltyEnabled Boolean @default(true)
  loyaltyVisits  Int     @default(3)
  loyaltyDiscountPct Float @default(10)
  receiptFooter  String?
  /** Public QR-menu URL slug — `/?menu=<slug>` opens this branch's customer menu. */
  menuSlug     String? @unique
  /** First-visit discount advertised on the QR menu (0 = hide the registration CTA). */
  menuOfferPct Int     @default(10)
  /** Optional hero tagline for the QR menu (falls back to a generated line). */
  menuTagline  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users             UserBranch[]
  transactions      Transaction[]
  serviceOverrides  ServiceOverride[]
  expenses          Expense[]
  menuLeads         MenuLead[]

  // Bill numbers are per-branch PREFIX-0001 — two branches of ONE franchise
  // sharing a prefix would collide globally on Transaction.billNo.
  @@unique([tenantId, billPrefix])
}

model User {
  id            String     @id @default(cuid())
  name          String
  /** Login identity (Firebase Auth, email/password). */
  email         String     @unique
  firebaseUid   String?    @unique
  role          String // "SUPER_ADMIN" | "ADMIN" | "STAFF"
  tenantId      String? // null only for SUPER_ADMIN (platform level)
  tenant        Tenant?    @relation(fields: [tenantId], references: [id])
  /** Staff-facing UI language preference ("en" | "hi") — synced server-side so
      a user's language follows them across devices. */
  lang          String?
  active        Boolean    @default(true)
  commissionPct Float      @default(0) // % of bill revenue paid out to this staff member
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  transactions  Transaction[]
  branches      UserBranch[]
  announcementReads AnnouncementRead[]
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@id([userId, branchId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String? // current POS branch context (null for SUPER_ADMIN sessions)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Franchise-level menu. Branches inherit prices via Service.price unless a
// ServiceOverride row exists for that branch.
model Category {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  name        String
  price       Float // franchise default price
  durationMin Int?
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id])
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  items       TransactionItem[]
  overrides   ServiceOverride[]
}

// Per-branch deviation from the franchise menu. price/active are null =
// "inherit the franchise value" (row deleted in practice, but nullable for
// partial overrides: a branch may override only price or only availability).
model ServiceOverride {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  price     Float?
  active    Boolean?

  @@unique([serviceId, branchId])
}

model Customer {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  mobile       String
  name         String?
  /** Recurring birthday as "MM-DD" (year unknown) — powers reminder lists. */
  birthday     String?
  /** When the salon last sent this customer a birthday wish (campaign tracking). */
  lastWishAt   DateTime?
  visits       Int           @default(0)
  totalSpend   Float         @default(0)
  lastVisitAt  DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  branchVisits BranchVisit[]
  menuLeads    MenuLead[]

  @@unique([tenantId, mobile])
}

// Optional: which branches a customer has visited (per-franchise loyalty is
// computed from Customer.visits; this is extra colour for the profile page).
model BranchVisit {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId   String
  branchName String
  visitedAt  DateTime @default(now())

  @@unique([customerId, branchId])
}

model Transaction {
  id             String            @id @default(cuid())
  billNo         String            @unique
  tenantId       String
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id])
  branchName     String // snapshot
  customerId     String?
  customer       Customer?         @relation(fields: [customerId], references: [id])
  customerMobile String?
  customerName   String?
  staffId        String
  staff          User              @relation(fields: [staffId], references: [id])
  staffName      String
  subtotal       Float
  discountPct    Float             @default(0)
  discountAmount Float             @default(0) // computed store (flat or pct)
  /** Flat-₹ discount (mutually exclusive with discountPct > 0). Null = percentage/none. */
  discountFlat   Float?
  gstPct         Float             @default(0)
  gstAmount      Float             @default(0)
  /** Staff-collected tip — added AFTER GST, never commissioned, never discounted. */
  tipAmount      Float             @default(0)
  total          Float
  paymentMethod  String // "CASH" | "UPI" | "CARD" | "SPLIT" (SPLIT = >1 payment rows)
  note           String?
  status         String            @default("COMPLETED") // "COMPLETED" | "VOIDED"
  /** Idempotency key from the offline bill queue — a retried sync must never
      double-bill. Same key returns the original transaction. */
  clientRequestId String? @unique
  /** When the staff actually took the payment (offline bills sync later with
      their true local timestamp, not the sync time). */
  clientCreatedAt DateTime?
  voidedAt       DateTime?
  voidedByUserId String?
  voidReason     String?
  createdAt      DateTime          @default(now())
  items          TransactionItem[]
  payments       TransactionPayment[]

  @@index([branchId, createdAt])
  @@index([tenantId, createdAt])
  @@index([customerId])
  @@index([staffId, createdAt])
  @@index([status])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id])
  serviceName   String
  price         Float
  qty           Int
}

// One bill may be settled in several ways at once (e.g. ₹600 cash + ₹400 UPI).
// Each row is a slice of the bill's total; the sum always equals the total
// exactly (the API forces the last slice to absorb sub-paisa rounding).
// branchId/tenantId/createdAt are denormalized from the bill so payment-level
// aggregation (cash handover, method mix) never needs a join.
model TransactionPayment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  method        String // "CASH" | "UPI" | "CARD"
  amount        Float
  branchId      String
  tenantId      String
  createdAt     DateTime    @default(now())

  @@unique([transactionId, method])
  @@index([tenantId, createdAt])
  @@index([branchId, createdAt])
}

model Expense {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  category      String // "RENT" | "SUPPLIES" | "SALARY" | "UTILITY" | "MARKETING" | "MAINTENANCE" | "OTHER"
  description   String?
  amount        Float
  date          DateTime // the day the expense occurred (owner may log past expenses)
  createdByName String // snapshot of who logged it
  createdAt     DateTime @default(now())

  @@index([branchId, date])
}

// Franchise-level announcements shown in the bell menu (branch approved /
// paused, welcome, festive notes from the platform). tenantId null =
// platform-console-only announcement (visible to SUPER_ADMIN).
model Announcement {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String // "BRANCH_APPROVED" | "BRANCH_DECLINED" | "BRANCH_PAUSED" | "WELCOME" | "INFO"
  title     String
  body      String
  createdAt DateTime @default(now())
  reads     AnnouncementRead[]

  @@index([tenantId, createdAt])
}

// Per-user read receipts — an announcement without one is "new" for that user.
model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

// A customer who registered via the public QR menu to claim a first-visit
// discount. The code is shown at the counter; it auto-redeems on the first
// discounted bill at THIS branch (see POST /api/transactions) — one lead per
// bill, never all of a customer's leads across branches. Voiding the bill
// un-redeems the lead via `redeemedByTransactionId` so the offer survives.
model MenuLead {
  id         String    @id @default(cuid())
  code       String    @unique
  tenantId   String
  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mobile     String
  name       String?
  pct        Int
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?
  /** The bill that honoured this lead — set on redemption so a void can
      surgically un-redeem ONLY this lead (not every lead the customer has). */
  redeemedByTransactionId String?

  @@index([tenantId, mobile])
  @@index([branchId, mobile, createdAt])
  @@index([customerId])
  @@index([redeemedByTransactionId])
}
