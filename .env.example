# SQLite database location (absolute path recommended)
DATABASE_URL=file:/absolute/path/to/db/custom.db

# Set to "true" ONLY on demo deployments — shows the demo-accounts card on the
# login screen. Production must leave this unset/hidden.
# NEXT_PUBLIC_SHOW_DEMO_HINTS=true

# Force secure cookies behind a TLS proxy when NODE_ENV isn't production.
# FORCE_SECURE_COOKIES=1
